{%- comment -%}Bloc prix (repris de la structure observée : prix réduit + prix barré){%- endcomment -%}
{%- if product.compare_at_price > product.price -%}
  <span class="product-card__price">
    <s>{% render 'montant', centimes: product.compare_at_price %}</s>{% render 'montant', centimes: product.price %}
  </span>
{%- else -%}
  <span class="product-card__price">{% render 'montant', centimes: product.price %}</span>
{%- endif -%}
