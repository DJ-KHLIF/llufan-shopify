{%- comment -%}
  Formulaire de commande — paiement à la livraison (fiche produit et page panier).

  ⚠ VERSION DE TEST — SIMULATION UNIQUEMENT.
  Ce formulaire ne crée AUCUNE commande Shopify et n'envoie rien : l'envoi est
  intercepté par assets/llufan-livraison.js, qui vérifie les champs, affiche
  le récapitulatif puis un message « simulation » (français / arabe).
  Passer à de vraies commandes demande une intégration côté serveur (chantier
  séparé) : ne pas transformer ce message en confirmation de commande.

  Paramètres :
    mode               'produit' (fiche produit) ou 'panier' (page panier)
    cle                identifiant unique du formulaire dans la page
    titre              titre de l'encart (vide → titre par défaut traduit)
    barre_mobile       barre « Voir le formulaire » en bas d'écran (mobile)
    formulaire_produit identifiant du formulaire d'ajout au panier (mode produit)

  Les textes viennent des fichiers de langue (clés « commande.* ») ; les
  wilayas, communes et tarifs viennent de assets/llufan-livraison-dz.json.
{%- endcomment -%}
{%- liquid
  assign mode = mode | default: 'panier'
  assign cle = cle | default: 'commande'
  assign titre = titre | default: '' | strip
  if titre == blank
    assign titre = 'commande.titre_defaut' | t
  endif
  if barre_mobile == nil
    assign barre_mobile = true
  endif
  if mode == 'produit'
    assign reference = product.selected_or_first_available_variant.price
  else
    assign reference = cart.total_price
  endif
-%}

<span id="commander" class="commande__ancre" aria-hidden="true"></span>
<div
  class="commande-wrapper"
  id="commande-{{ cle }}"
  data-llufan-commande
  data-src="{{ 'llufan-livraison-dz.json' | asset_url }}"
>
  <script type="application/json" data-llufan-donnees>
    {
      "mode": {{ mode | json }},
      "langue": {{ request.locale.iso_code | json }},
      "devise": {{ 'general.devise' | t | json }},
      {%- if mode == 'produit' -%}
        "formulaireProduit": {{ formulaire_produit | json }},
        "produit": {{ product.title | json }},
        "varianteInitiale": {{ product.selected_or_first_available_variant.id | json }},
        "variantes": [
          {%- for variante in product.variants -%}
            {"id": {{ variante.id }}, "titre": {% if product.has_only_default_variant %}null{% else %}{{ variante.title | json }}{% endif %}, "prix": {{ variante.price }}, "dispo": {{ variante.available }}}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ],
      {%- else -%}
        "total": {{ cart.total_price }},
        "lignes": [
          {%- for item in cart.items -%}
            {"cle": {{ item.key | json }}, "quantite": {{ item.quantity }}, "produit": {{ item.product.title | json }}, "variante": {% if item.product.has_only_default_variant %}null{% else %}{{ item.variant.title | json }}{% endif %}, "total": {{ item.final_line_price }}}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ],
      {%- endif -%}
      "textes": {
        "domicile": {{ 'commande.domicile' | t | json }},
        "stopDesk": {{ 'commande.stop_desk' | t | json }},
        "aCalculer": {{ 'commande.a_calculer' | t | json }},
        "choisir": {{ 'commande.choisir' | t | json }},
        "wilayaDabord": {{ 'commande.wilaya_dabord' | t | json }},
        "recapNom": {{ 'commande.recap_nom' | t | json }},
        "recapTelephone": {{ 'commande.recap_telephone' | t | json }},
        "recapWilaya": {{ 'commande.recap_wilaya' | t | json }},
        "recapCommune": {{ 'commande.recap_commune' | t | json }},
        "recapType": {{ 'commande.recap_type' | t | json }},
        "recapAdresse": {{ 'commande.recap_adresse' | t | json }},
        "recapSousTotal": {{ 'commande.recap_sous_total' | t | json }},
        "recapFrais": {{ 'commande.recap_frais' | t | json }},
        "recapTotal": {{ 'commande.recap_total' | t | json }},
        "erreurResume": {{ 'commande.erreurs.resume' | t | json }},
        "erreurNom": {{ 'commande.erreurs.nom' | t | json }},
        "erreurTelephone": {{ 'commande.erreurs.telephone' | t | json }},
        "erreurWilaya": {{ 'commande.erreurs.wilaya' | t | json }},
        "erreurCommune": {{ 'commande.erreurs.commune' | t | json }},
        "erreurAdresse": {{ 'commande.erreurs.adresse' | t | json }},
        "erreurTarif": {{ 'commande.erreurs.tarif' | t | json }},
        "erreurVariante": {{ 'commande.erreurs.variante' | t | json }},
        "erreurTarifsCharges": {{ 'commande.erreurs.tarifs_indisponibles' | t | json }}
      }
    }
  </script>

  <div class="commande-encart{% if mode == 'produit' %} commande-encart--produit{% endif %}">
    <h2 class="commande__titre">{{ titre }}</h2>
    <p class="commande__simulation">{{ 'commande.simulation_bandeau' | t }}</p>

    <form class="commande" id="commande-formulaire-{{ cle }}" action="#" novalidate data-llufan-formulaire>
      <p class="commande__avertissement" data-llufan-avertissement role="alert" tabindex="-1" hidden></p>

      <div class="commande__champs">
        <div class="field">
          <label class="field__label" for="{{ cle }}-nom">{{ 'commande.nom' | t }} <span aria-hidden="true">*</span></label>
          <input class="input" id="{{ cle }}-nom" type="text" name="contact[Nom complet]" autocomplete="name" placeholder="{{ 'commande.nom_placeholder' | t }}" required aria-required="true" aria-describedby="{{ cle }}-nom-erreur" data-llufan-champ="nom">
          <p class="field__erreur" id="{{ cle }}-nom-erreur" data-llufan-erreur="nom" hidden></p>
        </div>
        <div class="field">
          <label class="field__label" for="{{ cle }}-telephone">{{ 'commande.telephone' | t }} <span aria-hidden="true">*</span></label>
          <input class="input commande__telephone" id="{{ cle }}-telephone" type="tel" name="contact[Téléphone]" dir="ltr" inputmode="tel" autocomplete="tel" placeholder="05 / 06 / 07 …" pattern="[0-9+][0-9+ ]{8,17}" required aria-required="true" aria-describedby="{{ cle }}-telephone-aide {{ cle }}-telephone-erreur" data-llufan-champ="telephone">
          <p class="field__aide" id="{{ cle }}-telephone-aide">{{ 'commande.telephone_aide' | t }}</p>
          <p class="field__erreur" id="{{ cle }}-telephone-erreur" data-llufan-erreur="telephone" hidden></p>
        </div>
        <div class="field">
          <label class="field__label" for="{{ cle }}-wilaya">{{ 'commande.wilaya' | t }} <span aria-hidden="true">*</span></label>
          <select class="select" id="{{ cle }}-wilaya" name="contact[Wilaya]" required aria-required="true" aria-describedby="{{ cle }}-wilaya-erreur" data-llufan-wilaya data-llufan-champ="wilaya">
            <option value="">{{ 'commande.choisir' | t }}</option>
          </select>
          <p class="field__erreur" id="{{ cle }}-wilaya-erreur" data-llufan-erreur="wilaya" hidden></p>
        </div>
        <div class="field">
          <label class="field__label" for="{{ cle }}-commune">{{ 'commande.commune' | t }} <span aria-hidden="true">*</span></label>
          <select class="select" id="{{ cle }}-commune" name="contact[Commune]" required aria-required="true" aria-describedby="{{ cle }}-commune-erreur" disabled data-llufan-commune data-llufan-champ="commune">
            <option value="">{{ 'commande.wilaya_dabord' | t }}</option>
          </select>
          <p class="field__erreur" id="{{ cle }}-commune-erreur" data-llufan-erreur="commune" hidden></p>
        </div>
      </div>

      <fieldset class="commande__livraison" data-llufan-type>
        <legend class="field__label">{{ 'commande.livraison' | t }}</legend>
        <label class="commande__option is-selected" for="{{ cle }}-type-domicile" data-llufan-type-item>
          <input type="radio" id="{{ cle }}-type-domicile" name="contact[Type de livraison]" value="domicile" checked>
          <span>{{ 'commande.domicile' | t }}</span>
          <span class="commande__option-prix" data-llufan-prix="domicile">—</span>
        </label>
        <label class="commande__option" for="{{ cle }}-type-stop-desk" data-llufan-type-item>
          <input type="radio" id="{{ cle }}-type-stop-desk" name="contact[Type de livraison]" value="stop-desk">
          <span>{{ 'commande.stop_desk' | t }}</span>
          <span class="commande__option-prix" data-llufan-prix="stop-desk">—</span>
        </label>
      </fieldset>

      {%- comment -%}
        Adresse : visible et obligatoire à domicile ; en stop-desk, masquée,
        désactivée (donc jamais envoyée), non obligatoire et absente du
        récapitulatif. C'est le script qui bascule ces états.
      {%- endcomment -%}
      <div class="field commande__adresse" data-llufan-adresse-bloc>
        <label class="field__label" for="{{ cle }}-adresse">{{ 'commande.adresse' | t }} <span aria-hidden="true">*</span></label>
        <textarea class="textarea" id="{{ cle }}-adresse" name="contact[Adresse]" rows="3" autocomplete="street-address" minlength="5" required aria-required="true" aria-describedby="{{ cle }}-adresse-erreur" placeholder="{{ 'commande.adresse_placeholder' | t }}" data-llufan-adresse data-llufan-champ="adresse"></textarea>
        <p class="field__erreur" id="{{ cle }}-adresse-erreur" data-llufan-erreur="adresse" hidden></p>
      </div>

      <div class="commande__totaux">
        <div class="commande__total-ligne"><span>{{ 'commande.sous_total' | t }}</span><span data-llufan-sous-total>{% render 'montant', centimes: reference %}</span></div>
        <div class="commande__total-ligne"><span>{{ 'commande.frais' | t }}</span><span data-llufan-frais>{{ 'commande.a_calculer' | t }}</span></div>
        <div class="commande__total-ligne commande__total-ligne--total"><span>{{ 'commande.total' | t }}</span><span data-llufan-total>—</span></div>
        <p class="commande__tarifs-note">{{ 'commande.tarifs_indicatifs' | t }}</p>
      </div>

      <section class="commande__recap" aria-labelledby="{{ cle }}-recap-titre">
        <h3 class="commande__recap-titre" id="{{ cle }}-recap-titre">{{ 'commande.recap_titre' | t }}</h3>
        {%- comment -%}Texte brut du récapitulatif, prêt pour une future intégration serveur.{%- endcomment -%}
        <textarea name="contact[body]" data-llufan-recapitulatif hidden aria-hidden="true" tabindex="-1"></textarea>
        <div class="commande__recap-liste" data-llufan-recap-visible></div>
      </section>

      <button type="submit" class="button button--coral button--lg commande__bouton" data-llufan-bouton>{{ 'commande.bouton_simulation' | t }}</button>
      <div class="commande__confirmation" data-llufan-confirmation role="status" tabindex="-1" hidden>
        <p><strong>{{ 'commande.simulation_titre' | t }}</strong></p>
        <p>{{ 'commande.simulation_confirmation' | t }}</p>
      </div>
      <div class="commande__reassurance">
        <span>{{ 'commande.sans_paiement' | t }}</span>
        <span>{{ 'commande.version_test' | t }}</span>
      </div>
    </form>

    <div class="commande__infos">
      <p>{{ 'commande.delai' | t }}</p>
      <p class="text-subdued">{{ 'commande.mentions' | t }}</p>
    </div>
  </div>

  {%- if barre_mobile -%}
    <div class="commande__barre-espace" aria-hidden="true"></div>
    <div class="commande__barre">
      <span class="commande__barre-montant" data-llufan-sticky-total>{% render 'montant', centimes: reference %}</span>
      <a href="#commande-{{ cle }}" class="button button--coral" data-llufan-sticky>{{ 'commande.voir_formulaire' | t }}</a>
    </div>
  {%- endif -%}
</div>
<script src="{{ 'llufan-livraison.js' | asset_url }}" defer></script>
