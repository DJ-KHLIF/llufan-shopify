{%- comment -%}
  Commande — paiement à la livraison
  ---------------------------------------------------------------------------
  La cliente choisit sa wilaya, sa commune et le type de livraison ; le total
  estimé se calcule en direct (assets/llufan-livraison.js). À l'envoi, elle
  part vers la caisse Shopify par un lien de panier (« cart permalink ») :
    • fiche produit : la variante et la quantité choisies, avec les
      informations de livraison en propriétés de ligne ;
    • page panier : les articles du panier, avec les mêmes informations en
      attributs de commande (section « Détails supplémentaires » de la commande).
  Dans les deux cas, le nom, la commune, la wilaya et l'adresse pré-remplissent
  l'adresse de livraison de la caisse. Les frais affichés ici sont une
  estimation : le tarif facturé vient des zones d'expédition Shopify.

  Paramètres : mode ('produit' | 'panier'), cle, titre, cta, barre_mobile, devise.
{%- endcomment -%}

{%- assign mode = mode | default: 'panier' -%}
{%- assign cle = cle | default: 'commande' -%}
{%- assign defaut_titre = 'commande.titre_defaut' | t -%}
{%- assign titre = titre | default: defaut_titre -%}
{%- assign defaut_cta = 'commande.cta_defaut' | t -%}
{%- assign cta = cta | default: defaut_cta -%}
{%- comment -%}
  Le texte du bouton saisi dans l'éditeur est en français : sur une page en
  arabe, on prend la traduction du thème (même règle que le titre de la fiche).
{%- endcomment -%}
{%- if request.locale.iso_code == 'ar' -%}
  {%- assign cta = defaut_cta -%}
{%- endif -%}
{%- assign barre_mobile = barre_mobile | default: true -%}

{%- if mode == 'produit' -%}
  {%- assign reference = product.selected_or_first_available_variant.price -%}
  {%- assign variante_initiale = product.selected_or_first_available_variant -%}
  <script type="application/json" data-llufan-variantes>
    [{%- for variante in product.variants -%}
      {"id": {{ variante.id }}, "titre": {{ variante.title | json }}, "prix": {{ variante.price }}, "dispo": {{ variante.available }}}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}]
  </script>
{%- else -%}
  {%- assign reference = cart.total_price -%}
  {%- capture articles_du_panier -%}
    {%- for item in cart.items -%}{{ item.variant_id }}:{{ item.quantity }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}
  {%- endcapture -%}
{%- endif -%}

<span id="commander" class="commande__ancre" aria-hidden="true"></span>
<div
  class="commande-wrapper"
  id="commande-{{ cle }}"
  data-commande-{{ cle }}
  data-llufan-commande
  data-mode-section="{{ mode }}"
  data-src="{{ 'llufan-livraison-dz.json' | asset_url }}"
  data-devise="{{ devise | default: 'DA' | escape }}"
  data-sous-total="{{ reference }}"
  data-produit="{{ product.title | escape }}"
  data-articles="{{ articles_du_panier | strip }}"
  data-langue="{{ request.locale.iso_code }}"
  data-libelle-domicile="{{ 'commande.domicile' | t | escape }}"
  data-libelle-stop-desk="{{ 'commande.stop_desk' | t | escape }}"
  data-libelle-a-calculer="{{ 'commande.a_calculer' | t | escape }}"
  data-libelle-choisir="{{ 'commande.choisir' | t | escape }}"
  data-libelle-choix-incomplet="{{ 'commande.choix_incomplet' | t | escape }}"
  data-libelle-indisponible="{{ 'products.product.sold_out' | t | escape }}"
  data-libelle-envoi="{{ 'commande.envoi' | t | escape }}"
>
  <div class="commande-encart{% if mode == 'produit' %} commande-encart--produit{% endif %}">
    {%- if titre != blank -%}
      <p class="commande__titre">{{ titre }}</p>
    {%- endif -%}

    {%- comment -%}
      Sans JavaScript, le formulaire reste un ajout au panier classique (fiche
      produit) ou une mise à jour du panier suivie de la caisse (page panier).
      Avec JavaScript, l'envoi passe par le lien de panier (voir plus haut).
    {%- endcomment -%}
    {%- assign id_formulaire_commande = 'commande-formulaire-' | append: cle -%}
    {%- if mode == 'produit' -%}
      {%- assign action_formulaire = routes.cart_add_url -%}
      {%- assign prefixe = 'properties' -%}
    {%- else -%}
      {%- assign action_formulaire = routes.cart_url -%}
      {%- assign prefixe = 'attributes' -%}
    {%- endif -%}
    <form class="commande" id="{{ id_formulaire_commande }}" action="{{ action_formulaire }}" method="post" accept-charset="UTF-8">
      {%- if mode == 'produit' -%}
        <input type="hidden" name="id" value="{{ variante_initiale.id }}" data-llufan-id>
        <input type="hidden" name="quantity" value="1" data-llufan-quantite>
        <input type="hidden" name="return_to" value="/checkout">
      {%- else -%}
        <input type="hidden" name="checkout" value="1">
      {%- endif -%}
      <p class="commande__avertissement" data-llufan-avertissement role="alert" hidden></p>

      <div class="commande__champs">
        <label class="field">
          <span class="field__label">{{ 'commande.nom' | t }} *</span>
          <input class="input" type="text" name="{{ prefixe }}[Nom complet]" autocomplete="name" placeholder="{{ 'commande.nom_placeholder' | t }}" required data-llufan-nom>
        </label>
        <label class="field">
          <span class="field__label">{{ 'commande.telephone' | t }} *</span>
          <input class="input" type="tel" name="{{ prefixe }}[Téléphone]" inputmode="tel" autocomplete="tel" placeholder="05 / 06 / 07 …" pattern="[0-9+][0-9+ ]{8,17}" title="{{ 'commande.telephone_aide' | t }}" required data-llufan-telephone>
        </label>
        <label class="field">
          <span class="field__label">{{ 'commande.wilaya' | t }} *</span>
          <select class="select" name="{{ prefixe }}[Wilaya]" data-llufan-wilaya required>
            <option value="">{{ 'commande.choisir' | t }}</option>
          </select>
        </label>
        <label class="field">
          <span class="field__label">{{ 'commande.commune' | t }} *</span>
          <select class="select" name="{{ prefixe }}[Commune]" data-llufan-commune required disabled>
            <option value="">{{ 'commande.wilaya_dabord' | t }}</option>
          </select>
        </label>
      </div>

      <fieldset class="commande__livraison" data-llufan-type>
        <legend class="field__label">{{ 'commande.livraison' | t }}</legend>
        <label class="commande__option" data-llufan-type-item>
          <input type="radio" name="{{ prefixe }}[Type de livraison]" value="domicile" checked>
          <span>{{ 'commande.domicile' | t }}</span>
          <span class="commande__option-prix" data-llufan-prix-domicile>—</span>
        </label>
        <label class="commande__option" data-llufan-type-item>
          <input type="radio" name="{{ prefixe }}[Type de livraison]" value="stop-desk">
          <span>{{ 'commande.stop_desk' | t }}</span>
          <span class="commande__option-prix" data-llufan-prix-stop-desk>—</span>
        </label>
      </fieldset>

      <label class="field" data-llufan-adresse-bloc>
        <span class="field__label">{{ 'commande.adresse' | t }} *</span>
        <textarea class="textarea" name="{{ prefixe }}[Adresse]" rows="3" autocomplete="street-address" required minlength="5" placeholder="{{ 'commande.adresse_placeholder' | t }}" data-llufan-adresse></textarea>
      </label>

      <div class="commande__totaux">
        <div class="commande__total-ligne"><span>{{ 'commande.sous_total' | t }}</span><span data-llufan-sous-total>{{ reference | money }}</span></div>
        <div class="commande__total-ligne"><span>{{ 'commande.frais' | t }}</span><span data-llufan-frais>{{ 'commande.a_calculer' | t }}</span></div>
        <div class="commande__total-ligne commande__total-ligne--total"><span>{{ 'commande.total' | t }}</span><span data-llufan-total>—</span></div>
      </div>
      <p class="commande__note text-subdued">{{ 'commande.frais_confirmes' | t }}</p>

      <button type="submit" class="button button--coral button--lg commande__bouton" data-llufan-bouton{% if mode == 'produit' %}{% unless variante_initiale.available %} disabled{% endunless %}{% endif %}>
        {{ cta }}
      </button>
      <div class="commande__reassurance">
        <span>{{ 'commande.sans_paiement' | t }}</span>
      </div>
    </form>

    <div class="commande__infos">
      <p>{{ 'commande.delai' | t }}</p>
      <p class="text-subdued">{{ 'commande.mentions' | t }}</p>
    </div>
  </div>

  {%- if barre_mobile -%}
    <div class="commande__barre-espace" aria-hidden="true"></div>
    <div class="commande__barre">
      <span class="commande__barre-montant" data-llufan-sticky-total>—</span>
      <a href="#commande-{{ cle }}" class="button button--coral" data-llufan-sticky>{{ 'commande.barre_cta' | t }}</a>
    </div>
  {%- endif -%}
</div>
<script src="{{ 'llufan-livraison.js' | asset_url }}" defer></script>
