{%- comment -%}
  Jeu d'icônes du thème (SVG dessinés pour LLUFAN, tracé simple et arrondi
  proche du rendu observé sur la référence de design).
  Usage : {% render 'icons', icon: 'search', size: 20 %}
{%- endcomment -%}
{%- assign s = size | default: 24 -%}
{%- case icon -%}
  {%- when 'search' -%}
    <svg class="icon icon-search" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.4"/><path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
  {%- when 'account' -%}
    <svg class="icon icon-account" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.4"/><path d="M4.5 21c1.4-3.9 4.1-5.8 7.5-5.8s6.1 1.9 7.5 5.8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
  {%- when 'bag' -%}
    <svg class="icon icon-bag" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M5 8h14l-1 12.5H6L5 8Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8" stroke="currentColor" stroke-width="1.4"/></svg>
  {%- when 'hamburger' -%}
    <svg class="icon icon-hamburger" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M3 7h18M3 12h18M3 17h18" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
  {%- when 'close' -%}
    <svg class="icon icon-close" width="{{ s }}" height="{{ s }}" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><path d="m1 1 14 14M1 15 15 1" stroke="currentColor" stroke-width="1.5"/></svg>
  {%- when 'chevron-down' -%}
    <svg class="icon icon-chevron-down" width="{{ s }}" height="{{ s }}" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><path d="m2 6 6 6 6-6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'chevron-left' -%}
    <svg class="icon icon-chevron-left" width="{{ s }}" height="{{ s }}" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><path d="M10 2 4 8l6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'tag' -%}
    <svg class="icon icon-tag" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M20.6 13.4 13 21a2 2 0 0 1-2.8 0L3 13.8V4h9.8l7.8 7.8a2 2 0 0 1 0 1.6Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
  {%- when 'whatsapp' -%}
    <svg class="icon icon-whatsapp" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M12 3.6a8.4 8.4 0 0 0-7.2 12.7L3.6 20.4l4.2-1.1A8.4 8.4 0 1 0 12 3.6Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M8.9 8.6c.3-.6.6-.6.9-.6h.6c.2 0 .5 0 .7.6l.7 1.7c.1.3 0 .5-.2.7l-.6.7c-.2.2-.2.4-.1.6.4.8 1.3 1.8 2.2 2.3.3.2.5.1.7-.1l.6-.7c.2-.2.4-.2.7-.1l1.6.8c.3.2.5.4.4.7-.1.7-.5 1.4-1.4 1.5-1.1.1-2.7-.5-4.3-1.9-1.5-1.3-2.3-2.8-2.4-3.9 0-1 .4-1.6.9-2Z" fill="currentColor" stroke="none"/></svg>
  {%- when 'mail' -%}
    <svg class="icon icon-mail" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="m3 7 9 6 9-6" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
  {%- when 'star-outline' -%}
    <svg class="icon icon-star-outline" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M12 3l2.5 5 5.5.8-4 3.8 1 5.4L12 15l-5 3 1-5.4-4-3.8 5.5-.8L12 3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
  {%- when 'heart-outline' -%}
    <svg class="icon icon-heart-outline" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M12 21s-7-4.5-9-9a5 5 0 0 1 9-3 5 5 0 0 1 9 3c-2 4.5-9 9-9 9Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
  {%- when 'chevron-right' -%}
    <svg class="icon icon-chevron-right" width="{{ s }}" height="{{ s }}" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><path d="m6 2 6 6-6 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'arrow-right' -%}
    <svg class="icon icon-arrow-right" width="{{ s }}" height="{{ s }}" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false"><path d="M3 10h14M11.5 4.5 17 10l-5.5 5.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'arrow-left' -%}
    <svg class="icon icon-arrow-left" width="{{ s }}" height="{{ s }}" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false"><path d="M17 10H3M8.5 4.5 3 10l5.5 5.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'star' -%}
    <svg class="icon icon-star" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M10 1.6l2.5 5.4 5.9.7-4.4 4 1.2 5.8L10 14.7 4.8 17.5 6 11.7 1.6 7.7l5.9-.7L10 1.6Z"/></svg>
  {%- when 'star-half' -%}
    <svg class="icon icon-star-half" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><defs><linearGradient id="llufan-half"><stop offset="50%" stop-color="currentColor"/><stop offset="50%" stop-color="currentColor" stop-opacity=".25"/></linearGradient></defs><path fill="url(#llufan-half)" d="M10 1.6l2.5 5.4 5.9.7-4.4 4 1.2 5.8L10 14.7 4.8 17.5 6 11.7 1.6 7.7l5.9-.7L10 1.6Z"/></svg>
  {%- when 'star-empty' -%}
    <svg class="icon icon-star-empty" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false" opacity=".28"><path d="M10 1.6l2.5 5.4 5.9.7-4.4 4 1.2 5.8L10 14.7 4.8 17.5 6 11.7 1.6 7.7l5.9-.7L10 1.6Z"/></svg>
  {%- when 'flower' -%}
    <svg class="icon icon-flower" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M12 21c0-3 0-6 0-7.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><path d="M12 13.5c-2.6 0-4.6-1.7-4.6-4S9.4 5 12 5s4.6 2.2 4.6 4.5-2 4-4.6 4Z" stroke="currentColor" stroke-width="1.3"/><path d="M12 9.6c1.3 0 2.4-1 2.4-2.3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
  {%- when 'shipping' -%}
    <svg class="icon icon-shipping" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M2.5 15.5c0-3.4 2.3-5.7 5.7-5.7s5.7 2.3 5.7 5.7" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><path d="M13.9 15.5h6.6v-3.2h-2.6l-1.6-2.5h-2.4" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><circle cx="6.4" cy="17.6" r="1.6" stroke="currentColor" stroke-width="1.3"/><circle cx="17.6" cy="17.6" r="1.6" stroke="currentColor" stroke-width="1.3"/><path d="M8 17.6h7.9" stroke="currentColor" stroke-width="1.3"/></svg>
  {%- when 'heart' -%}
    <svg class="icon icon-heart" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M12 20s-7.5-4.4-7.5-9.4A4.1 4.1 0 0 1 12 7.8a4.1 4.1 0 0 1 7.5 2.8c0 5-7.5 9.4-7.5 9.4Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
  {%- when 'payment' -%}
    <svg class="icon icon-payment" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><rect x="2.5" y="6" width="19" height="12" rx="2.5" stroke="currentColor" stroke-width="1.3"/><path d="M2.5 10h19" stroke="currentColor" stroke-width="1.3"/><path d="M6 14h4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
  {%- when 'gift' -%}
    <svg class="icon icon-gift" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M4 11h16v9H4z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="M3 7.5h18V11H3zM12 7.5V20" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="M12 7.5S10.8 3.6 9 4.2c-1.7.6-.6 3.3 3 3.3Zm0 0s1.2-3.9 3-3.3c1.7.6.6 3.3-3 3.3Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
  {%- when 'sparkle' -%}
    <svg class="icon icon-sparkle" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M12 3.5c.9 3.8 1.7 4.6 5.5 5.5-3.8.9-4.6 1.7-5.5 5.5-.9-3.8-1.7-4.6-5.5-5.5 3.8-.9 4.6-1.7 5.5-5.5Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="M17.5 15.5c.4 1.7.8 2.1 2.5 2.5-1.7.4-2.1.8-2.5 2.5-.4-1.7-.8-2.1-2.5-2.5 1.7-.4 2.1-.8 2.5-2.5Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/></svg>
  {%- when 'lock' -%}
    <svg class="icon icon-lock" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><rect x="5" y="10.5" width="14" height="9.5" rx="2" stroke="currentColor" stroke-width="1.3"/><path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
  {%- when 'filter' -%}
    <svg class="icon icon-filter" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M3 6h18M6 12h12M9.5 18h5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
  {%- when 'sort' -%}
    <svg class="icon icon-sort" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M7 4v16M7 20l-3-3M17 20V4M17 4l3 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'facebook' -%}
    <svg class="icon icon-facebook" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M13.5 21v-7.2h2.4l.4-2.8h-2.8V9.2c0-.8.2-1.4 1.4-1.4h1.5V5.3c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9V11H8v2.8h2.3V21h3.2Z"/></svg>
  {%- when 'instagram' -%}
    <svg class="icon icon-instagram" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><rect x="4" y="4" width="16" height="16" rx="4.5" stroke="currentColor" stroke-width="1.3"/><circle cx="12" cy="12" r="3.6" stroke="currentColor" stroke-width="1.3"/><circle cx="16.6" cy="7.4" r="1" fill="currentColor"/></svg>
  {%- when 'tiktok' -%}
    <svg class="icon icon-tiktok" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M15.5 3h-2.4v11.2a2.4 2.4 0 1 1-2.4-2.4c.2 0 .5 0 .7.1V9.4a4.9 4.9 0 1 0 4.1 4.8V8.6c1 .8 2.2 1.3 3.5 1.3V7.4a3.4 3.4 0 0 1-3.5-3.4V3Z"/></svg>
  {%- when 'plus' -%}
    <svg class="icon icon-plus" width="{{ s }}" height="{{ s }}" viewBox="0 0 12 12" fill="none" aria-hidden="true" focusable="false"><path d="M6 0v12M0 6h12" stroke="currentColor" stroke-width="1.5"/></svg>
  {%- when 'minus' -%}
    <svg class="icon icon-minus" width="{{ s }}" height="{{ s }}" viewBox="0 0 12 12" fill="none" aria-hidden="true" focusable="false"><path d="M0 6h12" stroke="currentColor" stroke-width="1.5"/></svg>
  {%- when 'zoom' -%}
    <svg class="icon icon-zoom" width="{{ s }}" height="{{ s }}" viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false"><path d="M9.432 9.432a4.94 4.94 0 1 1-6.985-6.985 4.94 4.94 0 0 1 6.985 6.985Zm0 0L13 13" stroke="currentColor" stroke-linecap="square"/><path d="M6 3.5V6m0 2.5V6m0 0H3.5h5" stroke="currentColor"/></svg>
  {%- when 'trash' -%}
    <svg class="icon icon-trash" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M5 7h14M9.5 7V5.4c0-.8.6-1.4 1.4-1.4h2.2c.8 0 1.4.6 1.4 1.4V7M7 7l.8 12.1c.1.8.7 1.4 1.5 1.4h5.4c.8 0 1.4-.6 1.5-1.4L17 7" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'locker' -%}
    <svg class="icon icon-locker" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M3 8h18v11H3z" stroke="currentColor" stroke-width="1.3"/><path d="M3 12h18M12 8v11" stroke="currentColor" stroke-width="1.3"/></svg>
{%- endcase -%}
