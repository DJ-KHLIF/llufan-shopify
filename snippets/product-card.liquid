{%- comment -%}
  Carte produit — structure reprise de la référence : visuel carré, badges
  en haut à gauche, second visuel au survol, titre en capitales centré,
  prix, note.
{%- endcomment -%}
{%- assign ratio = settings.card_image_ratio | default: 'square' -%}
{%- comment -%}
  « reveal » : vraie dans les grilles (apparition animée au défilement),
  fausse dans les carrousels (comme sur la référence, où les carrousels
  affichent les cartes sans attente).
{%- endcomment -%}
{%- assign reveal = reveal | default: false -%}
<product-card class="product-card"{% if reveal %} reveal-on-scroll="true"{% endif %}>
  <div class="product-card__figure">
    <div class="product-card__badges">
      {%- if product.available == false -%}
        <span class="badge badge--soldout">{{ 'products.product.sold_out' | t }}</span>
      {%- endif -%}
      {%- for block in badge_blocks -%}
        {%- assign applies = false -%}
        {%- if block.settings.products == blank or block.settings.products contains product.id -%}{%- assign applies = true -%}{%- endif -%}
        {%- if applies and block.settings.label != blank -%}
          <span class="badge badge--{{ block.settings.color }}">{{ block.settings.label }}</span>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <a class="product-card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
      {%- assign primary_class = 'product-card__image product-card__image--primary product-card__image--' | append: ratio -%}
      {%- if product.featured_media -%}
        {{ product.featured_media | image_url: width: 1200 | image_tag: loading: 'lazy', class: primary_class, widths: '300, 400, 600, 800, 1000, 1200', sizes: '(min-width: 1000px) 25vw, (min-width: 700px) 33vw, 50vw' }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'product-card__image product-card__placeholder' }}
      {%- endif -%}
      {%- if settings.card_show_second_image and product.media[1] -%}
        {{ product.media[1] | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'product-card__image product-card__image--secondary', widths: '300, 400, 600, 800, 1000, 1200', sizes: '(min-width: 1000px) 25vw, 50vw' }}
      {%- endif -%}
    </a>
    {%- if settings.card_show_quick_add -%}
      <div class="product-card__quick-add">
        {%- form 'product', product, data-cart-form: 'true' -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <button type="submit" class="button button--navy button--sm product-card__quick-add-button" aria-label="{{ 'products.product.add_to_cart' | t }}">
            <svg class="cart-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
              <path d="M5 8h14l-1 12.5H6L5 8Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
              <path d="M9 8V6.5a3 3 0 0 1 6 0V8" stroke="currentColor" stroke-width="1.4"/>
            </svg>
            <svg class="success-checkmark" viewBox="0 0 52 52" aria-hidden="true" focusable="false">
              <circle class="success-checkmark__circle" cx="26" cy="26" r="25"/>
              <path class="success-checkmark__check" d="M14.1 27.2l7.1 7.2 16.7-16.8"/>
            </svg>
          </button>
        {%- endform -%}
      </div>
    {%- endif -%}
  </div>
  <div class="product-card__info">
    <a class="product-card__title h6" href="{{ product.url }}">{{ product.title }}</a>
    {% render 'price', product: product %}
    {%- if settings.card_show_rating and settings.show_rating -%}
      {% render 'rating', product: product, class: 'justify-center' %}
    {%- endif -%}
  </div>
</product-card>
