{%- comment -%}Liste des collections — grille sur le modèle des cartes de collection{%- endcomment -%}
<div class="section-spacing color-scheme color-scheme--scheme-1">
  <div class="container">
    <div class="section-stack">
      <div class="section-header"><h1 class="h2--serif">{{ section.settings.heading | default: page_title }}</h1></div>
      <div class="collection-cards">
        {%- for collection in collections -%}
          <a class="collection-card" href="{{ collection.url }}" style="--card-ratio: 4 / 3">
            {%- if collection.featured_image != blank -%}
              {{ collection.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1200', sizes: '(min-width: 700px) 50vw, 100vw', alt: collection.title }}
            {%- else -%}
              {%- assign numero_collection = forloop.index | minus: 1 | modulo: 4 | plus: 1 -%}
              <img src="{{ 'demo-univers-' | append: numero_collection | append: '.jpg' | asset_img_url: '1000x' }}" alt="" loading="lazy">
            {%- endif -%}
            <span class="collection-card__overlay"></span>
            <div class="collection-card__content"><span class="collection-card__title">{{ collection.title }}</span></div>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Liste des collections",
  "tag": "section",
  "settings": [ { "type": "text", "id": "heading", "label": "Titre" } ]
}
{% endschema %}
