{%- comment -%}
  Fiche produit — ordre des blocs relevé sur la référence : badges, titre,
  sous-titre serif, prix, note, sélecteur de variantes (pastilles rondes),
  quantité, bouton d'ajout, accordéons (utilisation / entretien / composition),
  réassurance, partage. Galerie : image principale + vignettes verticales (ordinateur).
{%- endcomment -%}
{%- assign product_form_id = 'product-form-' | append: section.id -%}
{%- assign product_info_payload = '{"title":"' | append: product.title | append: '","url":"' | append: product.url | append: '","price":"' | append: product.price | money | append: '"}' -%}
<div data-product-info hidden data-product-info='{{ product_info_payload | escape }}'></div>
<div class="section-spacing section-spacing--tight color-scheme color-scheme--scheme-1">
  <div class="container">
    <div class="product">
      <!-- Galerie -->
      <product-gallery class="product-gallery" data-product-id="{{ product.id }}">
        <div class="product-gallery__thumbs">
          {%- for media in product.media -%}
            {%- comment -%}
              Une vidéo n'est pas une image : la vignette affiche son image
              d'aperçu (la première image de la vidéo), sinon elle serait vide.
            {%- endcomment -%}
            {%- assign apercu = media.preview_image | default: media -%}
            <button type="button" class="product-gallery__thumb" data-gallery-thumb="{{ forloop.index0 }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="{{ 'products.product.media' | t }} {{ forloop.index }}">
              {{ apercu | image_url: width: 200 | image_tag: loading: 'lazy', alt: media.alt | default: product.title }}
            </button>
          {%- endfor -%}
        </div>
        <scroll-carousel class="product-gallery__carousel scroll-area">
          {%- for media in product.media -%}
            <div class="product-gallery__media" data-media-id="{{ media.id }}">
              {%- if media.media_type == 'video' -%}
                {%- comment -%}
                  Style relevé sur la référence : la vidéo d'une fiche est muette,
                  en boucle, avec ses commandes, mais elle ne se charge PAS avant
                  qu'on la regarde (preload: none) — seule son image d'aperçu
                  s'affiche, avec un bouton de lecture rond et blanc par-dessus.
                {%- endcomment -%}
                <div class="product-gallery__lecteur" data-lecteur>
                  {{ media | video_tag: controls: true, playsinline: true, muted: true, loop: true, preload: 'none', image_size: '1600x', class: 'product-gallery__video' }}
                  <button type="button" class="product-gallery__bouton" data-lire-video aria-label="{{ 'products.product.play_video' | t }}">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 6.4v11.2L18.5 12 9 6.4Z" fill="currentColor"/></svg>
                  </button>
                </div>
              {%- elsif media.media_type == 'external_video' -%}
                <div class="product-gallery__lecteur">{{ media | external_video_tag: class: 'product-gallery__video' }}</div>
              {%- else -%}
                {{ media | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1200, 1600', sizes: '(min-width: 1000px) 55vw, 100vw', alt: media.alt | default: product.title }}
              {%- endif -%}
            </div>
          {%- else -%}
            <div class="product-gallery__media">{{ 'product-1' | placeholder_svg_tag }}</div>
          {%- endfor -%}
        </scroll-carousel>
      </product-gallery>

      <!-- Informations -->
      <div class="product-info">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'badges' -%}
              <div class="product-info__block" {{ block.shopify_attributes }}>
                <div class="badge-list">
                  {%- for i in (1..4) -%}
                    {%- assign label = 'label_' | append: i -%}
                    {%- assign color = 'color_' | append: i -%}
                    {%- if block.settings[label] != blank -%}
                      <span class="badge badge--{{ block.settings[color] }}">{{ block.settings[label] }}</span>
                    {%- endif -%}
                  {%- endfor -%}
                  {%- unless product.available -%}<span class="badge badge--soldout">{{ 'products.product.sold_out' | t }}</span>{%- endunless -%}
                </div>
              </div>
            {%- when 'title' -%}
              <h1 class="product-info__title h1" {{ block.shopify_attributes }}>{{ product.title }}</h1>
            {%- when 'subtitle' -%}
              {%- if block.settings.text != blank -%}
                <div class="prose" {{ block.shopify_attributes }}><h2 class="product-info__subtitle">{{ block.settings.text }}</h2></div>
              {%- endif -%}
            {%- when 'price' -%}
              <div class="product-info__block product-info__price" data-variant-price {{ block.shopify_attributes }}>
                {%- if product.compare_at_price > product.price -%}
                  <s>{{ product.compare_at_price | money }}</s>
                {%- endif -%}
                {{ product.price | money }}
              </div>
            {%- when 'rating' -%}
              {%- if settings.show_rating -%}
                <div class="product-info__block product-info__rating" {{ block.shopify_attributes }}>
                  {% render 'rating', product: product %}
                </div>
              {%- endif -%}
            {%- when 'variant_picker' -%}
              {%- unless product.has_only_default_variant -%}
                <variant-picker class="variant-picker" data-form-id="{{ product_form_id }}" {{ block.shopify_attributes }}>
                  <script type="application/json" data-variant-json>
                    [
                      {%- for variant in product.variants -%}
                        {
                          "id": {{ variant.id }},
                          "option1": {{ variant.option1 | json }},
                          "option2": {{ variant.option2 | json }},
                          "option3": {{ variant.option3 | json }},
                          "available": {{ variant.available }},
                          "price_formatted": {{ variant.price | money | json }}
                        }{% unless forloop.last %},{% endunless %}
                      {%- endfor -%}
                    ]
                  </script>
                  {%- for option in product.options_with_values -%}
                    <fieldset class="variant-picker__option">
                      <legend class="variant-picker__option-label">{{ option.name }}{% if option.name == 'Color' or option.name == 'Couleur' %}:{% endif %}</legend>
                      <div class="variant-picker__values">
                        {%- for value in option.values -%}
                          {%- assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index -%}
                          {%- assign variant_available = false -%}
                          {%- for variant in product.variants -%}
                            {%- if variant.options[option.position] == value and variant.available -%}{%- assign variant_available = true -%}{%- endif -%}
                          {%- endfor -%}
                          <input class="sr-only" type="radio" id="{{ input_id }}" name="option-{{ option.position }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %} {% if variant_available == false %}disabled{% endif %}>
                          {%- if option.name == 'Color' or option.name == 'Couleur' -%}
                            <label class="color-swatch{% if variant_available == false %} is-disabled{% endif %}" for="{{ input_id }}" data-swatch-value="{{ value | escape }}" title="{{ value | escape }}">
                              <span class="sr-only">{{ value }}</span>
                            </label>
                          {%- else -%}
                            <label class="variant-picker__value{% if variant_available == false %} is-disabled{% endif %}" for="{{ input_id }}">{{ value }}</label>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}
                  <p class="text-subdued" data-variant-availability hidden data-text-in-stock="{{ 'products.product.in_stock' | t }}" data-text-out-of-stock="{{ 'products.product.out_of_stock' | t }}"></p>
                </variant-picker>
              {%- endunless -%}
            {%- when 'buy_buttons' -%}
              <div class="product-info__block v-stack gap-4" {{ block.shopify_attributes }}>
                <div class="h-stack gap-4 items-center">
                  <div class="quantity-selector">
                    <button type="button" class="quantity-selector__button" data-quantity-button="minus" aria-label="{{ 'products.product.decrease_quantity' | t }}">{% render 'icons', icon: 'minus', size: 12 %}</button>
                    <input class="quantity-selector__input" type="number" name="quantity" form="{{ product_form_id }}" value="1" min="1" aria-label="{{ 'products.product.quantity' | t }}">
                    <span class="quantity-selector__spinner" aria-hidden="true"></span>
                    <button type="button" class="quantity-selector__button" data-quantity-button="plus" aria-label="{{ 'products.product.increase_quantity' | t }}">{% render 'icons', icon: 'plus', size: 12 %}</button>
                  </div>
                </div>
                {%- if block.settings.cta_direct -%}
                  <a href="#commande-{{ block.id }}" class="button button--navy button--full button--lg commande__raccourci">{{ block.settings.cta_direct_label }}</a>
                {%- endif -%}
                {%- form 'product', product, id: product_form_id, class: 'shopify-product-form', data-cart-form: 'true' -%}
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  <buy-buttons class="buy-buttons">
                    <button type="submit" class="button button--outline button--full button--lg"
                      data-text-add="{{ 'products.product.add_to_cart' | t }}"
                      data-text-sold-out="{{ 'products.product.sold_out' | t }}"
                      data-loading-label="{{ 'products.product.adding' | t }}"
                      {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
                      {%- if product.selected_or_first_available_variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
                    </button>
                    <p class="product-form__error" data-cart-error hidden></p>
                  </buy-buttons>
                {%- endform -%}
              </div>
            {%- when 'accordion' -%}
              <details class="accordion" {{ block.shopify_attributes }}>
                <summary class="accordion__toggle">
                  <span>{{ block.settings.title }}</span>
                  <span class="animated-plus" aria-hidden="true"></span>
                </summary>
                <div class="accordion__content prose">{{ block.settings.content }}</div>
              </details>
            {%- when 'trust' -%}
              <div class="product-trust" {{ block.shopify_attributes }}>
                <div class="text-with-icons" style="gap:1rem 2rem">
                  {%- for i in (1..3) -%}
                    {%- assign icon = 'icon_' | append: i -%}
                    {%- assign label = 'label_' | append: i -%}
                    {%- if block.settings[label] != blank -%}
                      <div class="text-with-icons__item">
                        <span class="text-with-icons__icon">{% render 'icons', icon: block.settings[icon], size: 28 %}</span>
                        <span class="text-with-icons__label" style="font-size:var(--text-base)">{{ block.settings[label] }}</span>
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            {%- when 'commande' -%}
              <div class="product-info__block" {{ block.shopify_attributes }}>
                {%- render 'forme-commande',
                  mode: 'produit',
                  cle: block.id,
                  titre: block.settings.heading,
                  cta: block.settings.cta,
                  barre_mobile: block.settings.barre_mobile -%}
              </div>
            {%- when 'description' -%}
              {%- comment -%}
                Un titre de niveau 2 précède la description : sans lui, les
                sous-titres de la fiche (Utilisation, Entretien, Composition)
                passaient directement d'un h1 à un h3.
              {%- endcomment -%}
              <div class="v-stack gap-3" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}<h2 class="h4">{{ block.settings.heading }}</h2>{%- endif -%}
                <div class="prose">{{ product.description }}</div>
              </div>
            {%- when 'share' -%}
              <div class="product-share" {{ block.shopify_attributes }}>
                <span class="eyebrow">{{ 'products.product.share' | t }}</span>
                <a href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url }}{{ product.url }}" target="_blank" rel="noopener">{% render 'icons', icon: 'facebook', size: 18 %}</a>
                <a href="https://pinterest.com/pin/create/button/?url={{ shop.url }}{{ product.url }}" target="_blank" rel="noopener" aria-label="Pinterest">{% render 'icons', icon: 'heart', size: 18 %}</a>
              </div>
            {%- when 'reviews' -%}
              {%- if settings.show_reviews_app -%}
                <div class="product-info__block" {{ block.shopify_attributes }}>{{ block.settings.heading }}</div>
              {%- endif -%}
            {%- when '@app' -%}
              {% render block %}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

