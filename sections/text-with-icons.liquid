{%- comment -%}
  Icônes avec texte — bandeau de réassurance (3 arguments sur la page d'accueil,
  3 arguments en bas de page). Les libellés restent vides tant que LLUFAN ne les
  a pas fournis : aucune promesse n'est inventée (délais, frais, paiement).
{%- endcomment -%}
<div class="section-spacing {% if section.settings.tight %}section-spacing--tight{% endif %} color-scheme color-scheme--scheme-1 {% if section.settings.border %}bordered-section{% endif %}">
  <div class="container">
    <div class="text-with-icons{% if section.settings.stacked %} text-with-icons--stacked{% endif %}">
      {%- for block in section.blocks -%}
        <div class="text-with-icons__item{% if section.settings.stacked %} text-with-icons__item--stacked{% endif %}" {{ block.shopify_attributes }}>
          <span class="text-with-icons__icon">{% render 'icons', icon: block.settings.icon, size: 34 %}</span>
          <div class="v-stack gap-1">
            {%- if block.settings.heading != blank -%}<p class="text-with-icons__label">{{ block.settings.heading }}</p>{%- endif -%}
            {%- if block.settings.text != blank -%}<div class="text-with-icons__text prose"><p>{{ block.settings.text }}</p></div>{%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Icônes avec texte",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "tight", "label": "Espacement réduit", "default": false },
    { "type": "checkbox", "id": "border", "label": "Trait de séparation en haut", "default": true },
    { "type": "checkbox", "id": "stacked", "label": "Icône au-dessus du texte", "default": false }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Argument",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icône", "options": [
          { "value": "flower", "label": "Fleur" },
          { "value": "shipping", "label": "Livraison" },
          { "value": "heart", "label": "Cœur" },
          { "value": "payment", "label": "Paiement" },
          { "value": "sparkle", "label": "Étoile" },
          { "value": "gift", "label": "Cadeau" },
          { "value": "lock", "label": "Cadenas" }
        ], "default": "flower" },
        { "type": "text", "id": "heading", "label": "Titre" },
        { "type": "text", "id": "text", "label": "Sous-titre" }
      ]
    }
  ],
  "presets": [ { "name": "Icônes avec texte", "blocks": [ { "type": "item" }, { "type": "item" }, { "type": "item" } ] } ]
}
{% endschema %}
