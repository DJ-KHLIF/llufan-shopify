{%- comment -%}
  Club Maman — espace d'échange entre mamans.
  ---------------------------------------------------------------------------
  Déroulé repris de l'espace équivalent de la référence de design :
  accueil (titre + texte), espaces d'échange, discussions, bandeau ressources,
  puis « rejoindre le club ».

  Deux différences assumées, écrites ici pour ne pas les chercher ailleurs :
  • La référence fait tourner un forum externe avec comptes membres. Shopify n'a
    pas de forum natif : l'inscription s'appuie donc sur le formulaire d'inscription
    de la boutique, sur la création d'un compte client et sur WhatsApp — trois
    mécanismes qui fonctionnent réellement.
  • Aucun contenu n'est inventé. Les espaces et les discussions sont des blocs :
    tant que LLUFAN ne les a pas saisis, la page affiche les textes d'attente
    prévus par les réglages.
{%- endcomment -%}

{%- assign espaces = section.blocks | where: 'type', 'espace' -%}
{%- assign discussions = section.blocks | where: 'type', 'discussion' -%}
{%- comment -%}
  Un bloc sans titre ne s'affiche pas : dans la boutique, rien d'anonyme ni de fictif
  n'apparaît. Les cartes n'existent que lorsque LLUFAN les a remplies.
{%- endcomment -%}
{%- assign espaces_remplis = 0 -%}
{%- for bloc in espaces -%}
  {%- if bloc.settings.titre != blank -%}{%- assign espaces_remplis = espaces_remplis | plus: 1 -%}{%- endif -%}
{%- endfor -%}
{%- assign discussions_remplies = 0 -%}
{%- for bloc in discussions -%}
  {%- if bloc.settings.titre != blank -%}{%- assign discussions_remplies = discussions_remplies | plus: 1 -%}{%- endif -%}
{%- endfor -%}
{%- assign cle = 'club-' | append: section.id -%}

<div class="section-spacing color-scheme color-scheme--scheme-1">
  <div class="container">
    <div class="section-stack">

      {%- comment -%} 1. Accueil : titre et texte {%- endcomment -%}
      {%- if section.settings.heading != blank or section.settings.intro != blank -%}
        <div class="club__accueil">
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h1 class="h2--serif">{{ section.settings.heading }}</h1>{%- endif -%}
          {%- if section.settings.intro != blank -%}<div class="prose club__intro">{{ section.settings.intro }}</div>{%- endif -%}
        </div>
      {%- endif -%}

      {%- comment -%} 2. Espaces d'échange {%- endcomment -%}
      {%- if espaces_remplis > 0 -%}
        <div class="v-stack gap-5">
          {%- if section.settings.espaces_titre != blank -%}
            <h2 class="h5 text-center">{{ section.settings.espaces_titre }}</h2>
          {%- endif -%}
          <div class="club__espaces">
            {%- for block in espaces -%}
              {%- if block.settings.titre == blank -%}{%- continue -%}{%- endif -%}
              {%- capture lien_espace -%}{%- render 'lien', valeur: block.settings.lien -%}{%- endcapture -%}
              {%- assign lien_espace = lien_espace | strip -%}
              {%- if lien_espace != blank -%}
                <a class="club__espace" href="{{ lien_espace }}" {{ block.shopify_attributes }}>
              {%- else -%}
                <div class="club__espace" {{ block.shopify_attributes }}>
              {%- endif -%}
                <span class="club__espace-icone">{% render 'icons', icon: block.settings.icone, size: 30 %}</span>
                {%- if block.settings.titre != blank -%}<span class="club__espace-titre">{{ block.settings.titre }}</span>{%- endif -%}
                {%- if block.settings.texte != blank -%}<span class="club__espace-texte">{{ block.settings.texte }}</span>{%- endif -%}
{%- if lien_espace != blank -%}</a>{%- else -%}</div>{%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- comment -%} 3. Discussions : cartes, ou texte d'attente {%- endcomment -%}
      {%- if discussions_remplies > 0 or section.settings.discussions_vide != blank -%}
        <div class="v-stack gap-5">
          {%- if section.settings.discussions_titre != blank -%}
            <h2 class="h5 text-center">{{ section.settings.discussions_titre }}</h2>
          {%- endif -%}
          {%- if discussions_remplies > 0 -%}
            <div class="club__discussions">
              {%- for block in discussions -%}
                {%- if block.settings.titre == blank -%}{%- continue -%}{%- endif -%}
                {%- capture lien_discussion -%}{%- render 'lien', valeur: block.settings.lien -%}{%- endcapture -%}
                {%- assign lien_discussion = lien_discussion | strip -%}
                {%- if lien_discussion != blank -%}
                  <a class="club__discussion" href="{{ lien_discussion }}" {{ block.shopify_attributes }}>
                {%- else -%}
                  <div class="club__discussion" {{ block.shopify_attributes }}>
                {%- endif -%}
                  {%- if block.settings.titre != blank -%}<span class="club__discussion-titre">{{ block.settings.titre }}</span>{%- endif -%}
                  {%- if block.settings.extrait != blank -%}<span class="club__discussion-extrait">{{ block.settings.extrait }}</span>{%- endif -%}
                  <span class="club__discussion-meta">
                    {%- if block.settings.autrice != blank -%}<span>{{ block.settings.autrice }}</span>{%- endif -%}
                    {%- if block.settings.reponses > 0 -%}<span>{{ block.settings.reponses }} {{ 'club.reponses' | t }}</span>{%- endif -%}
                    {%- if block.settings.likes > 0 -%}<span>{{ block.settings.likes }} {{ 'club.likes' | t }}</span>{%- endif -%}
                  </span>
  {%- if lien_discussion != blank -%}</a>{%- else -%}</div>{%- endif -%}
              {%- endfor -%}
            </div>
          {%- else -%}
            <div class="club__vide">
              <span class="club__vide-icone">{% render 'icons', icon: 'flower', size: 28 %}</span>
              <div class="prose">{{ section.settings.discussions_vide }}</div>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- comment -%} 4. Bandeau ressources {%- endcomment -%}
      {%- if section.settings.ressources_titre != blank or section.settings.ressources_texte != blank -%}
        <div class="club__ressources">
          <div class="v-stack gap-3">
            {%- if section.settings.ressources_titre != blank -%}
              <h2 class="h5">{{ section.settings.ressources_titre }}</h2>
            {%- endif -%}
            {%- if section.settings.ressources_texte != blank -%}
              <div class="prose">{{ section.settings.ressources_texte }}</div>
            {%- endif -%}
          </div>
          {%- capture lien_ressources -%}{%- render 'lien', valeur: section.settings.ressources_lien -%}{%- endcapture -%}
          {%- if section.settings.ressources_bouton != blank and lien_ressources != blank -%}
            <a href="{{ lien_ressources | strip }}" class="button button--navy">{{ section.settings.ressources_bouton }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- comment -%} 5. Rejoindre le club {%- endcomment -%}
      {%- if section.settings.rejoindre_titre != blank or section.settings.rejoindre_texte != blank -%}
        <div class="club__rejoindre" id="rejoindre-le-club">
          {%- if section.settings.rejoindre_titre != blank -%}
            <h2 class="h5">{{ section.settings.rejoindre_titre }}</h2>
          {%- endif -%}
          {%- if section.settings.rejoindre_texte != blank -%}
            <div class="prose club__intro">{{ section.settings.rejoindre_texte }}</div>
          {%- endif -%}

          {%- if section.settings.rejoindre_newsletter -%}
            {%- form 'customer', id: cle, class: 'club__formulaire' -%}
              <input type="hidden" name="contact[tags]" value="club-maman">
              {%- if form.posted_successfully? -%}
                <p class="club__confirmation">{{ section.settings.rejoindre_confirmation }}</p>
              {%- else -%}
                <label class="sr-only" for="{{ cle }}-email">{{ 'club.email' | t }}</label>
                <input id="{{ cle }}-email" class="input" type="email" name="contact[email]" required
                       autocomplete="email" placeholder="{{ 'club.email' | t }}">
                <button type="submit" class="button button--coral">{{ section.settings.rejoindre_bouton }}</button>
              {%- endif -%}
              {%- if form.errors -%}
                <p class="club__erreur">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
              {%- endif -%}
            {%- endform -%}
            {%- if section.settings.rejoindre_note != blank -%}
              <p class="club__note">{{ section.settings.rejoindre_note }}</p>
            {%- endif -%}
          {%- endif -%}

          {%- if section.settings.rejoindre_compte or section.settings.rejoindre_whatsapp -%}
            <div class="club__rejoindre-liens">
              {%- if section.settings.rejoindre_compte -%}
                <a href="{{ routes.account_register_url }}" class="link">{{ section.settings.rejoindre_compte_label }}</a>
              {%- endif -%}
              {%- if section.settings.rejoindre_whatsapp -%}
                {% render 'whatsapp', mode: 'bouton', style: 'outline' %}
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Club Maman",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre" },
    { "type": "text", "id": "heading", "label": "Titre de la page", "default": "Club Maman" },
    { "type": "richtext", "id": "intro", "label": "Texte d'accueil", "info": "Texte d'ouverture de LLUFAN : ce que le club est et n'est pas." },

    { "type": "header", "content": "Espaces d'échange" },
    { "type": "text", "id": "espaces_titre", "label": "Titre de la liste", "default": "Nos espaces d'échange" },

    { "type": "header", "content": "Discussions" },
    { "type": "text", "id": "discussions_titre", "label": "Titre de la liste", "default": "Discussions" },
    { "type": "richtext", "id": "discussions_vide", "label": "Texte affiché tant qu'aucune discussion n'est saisie" },

    { "type": "header", "content": "Bandeau ressources" },
    { "type": "text", "id": "ressources_titre", "label": "Titre" },
    { "type": "richtext", "id": "ressources_texte", "label": "Texte" },
    { "type": "text", "id": "ressources_bouton", "label": "Libellé du bouton" },
    { "type": "url", "id": "ressources_lien", "label": "Lien du bouton" },

    { "type": "header", "content": "Rejoindre le club" },
    { "type": "text", "id": "rejoindre_titre", "label": "Titre", "default": "Rejoindre le Club Maman" },
    { "type": "richtext", "id": "rejoindre_texte", "label": "Texte" },
    { "type": "checkbox", "id": "rejoindre_newsletter", "label": "Afficher le formulaire d'inscription", "default": true },
    { "type": "text", "id": "rejoindre_bouton", "label": "Libellé du bouton d'inscription", "default": "Je m'inscris" },
    { "type": "text", "id": "rejoindre_confirmation", "label": "Message de confirmation", "default": "Merci, votre inscription est enregistrée." },
    { "type": "text", "id": "rejoindre_note", "label": "Mention sous le formulaire", "info": "Exemple : finalité de l'inscription, lien vers la politique de confidentialité." },
    { "type": "checkbox", "id": "rejoindre_compte", "label": "Proposer la création d'un compte client", "default": true },
    { "type": "text", "id": "rejoindre_compte_label", "label": "Libellé du lien de compte", "default": "Créer mon compte" },
    { "type": "checkbox", "id": "rejoindre_whatsapp", "label": "Proposer WhatsApp (numéro des réglages du thème)", "default": true }
  ],
  "blocks": [
    {
      "type": "espace",
      "name": "Espace d'échange",
      "settings": [
        { "type": "select", "id": "icone", "label": "Icône", "options": [
          { "value": "flower", "label": "Fleur" },
          { "value": "heart", "label": "Cœur" },
          { "value": "sparkle", "label": "Étoile" },
          { "value": "star", "label": "Étoile pleine" },
          { "value": "gift", "label": "Cadeau" },
          { "value": "tag", "label": "Étiquette" },
          { "value": "mail", "label": "Message" },
          { "value": "account", "label": "Personne" },
          { "value": "whatsapp", "label": "WhatsApp" }
        ], "default": "flower" },
        { "type": "text", "id": "titre", "label": "Titre" },
        { "type": "textarea", "id": "texte", "label": "Texte" },
        { "type": "url", "id": "lien", "label": "Lien", "info": "Sans lien, l'espace reste affiché mais n'est pas cliquable." }
      ]
    },
    {
      "type": "discussion",
      "name": "Discussion",
      "settings": [
        { "type": "text", "id": "titre", "label": "Titre de la discussion" },
        { "type": "textarea", "id": "extrait", "label": "Début du message" },
        { "type": "text", "id": "autrice", "label": "Prénom de l'autrice" },
        { "type": "number", "id": "reponses", "label": "Nombre de réponses", "default": 0 },
        { "type": "number", "id": "likes", "label": "Nombre de likes", "default": 0 },
        { "type": "url", "id": "lien", "label": "Lien vers la discussion" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Club Maman",
      "settings": {
        "eyebrow": "Espace d'échange"
      },
      "blocks": [
        { "type": "espace" },
        { "type": "espace" },
        { "type": "espace" },
        { "type": "espace" }
      ]
    }
  ]
}
{% endschema %}
