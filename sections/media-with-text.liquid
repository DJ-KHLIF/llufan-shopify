{%- comment -%}
  Bloc éditorial (structure observée : deux visuels qui se chevauchent à gauche,
  sur-titre, titre en capitales, paragraphe et bouton à droite).
{%- endcomment -%}
<div class="section-spacing color-scheme color-scheme--scheme-1">
  <div class="container container--md">
    <div class="media-with-text">
      <div class="media-with-text__media">
        {%- if section.settings.image_main == blank and section.settings.image_secondary == blank and settings.mode_demo -%}
          <div class="media-with-text__image-main"><img src="{{ 'demo-editorial.jpg' | asset_img_url: '1200x' }}" alt="" width="900" height="1100" loading="lazy"></div>
          <div class="media-with-text__image-secondary"><img src="{{ 'llufan-nomad-coussin.jpg' | asset_img_url: '800x' }}" alt="" width="1200" height="896" loading="lazy"></div>
        {%- endif -%}
        {%- if section.settings.image_main != blank -%}
          <div class="media-with-text__image-main">{{ section.settings.image_main | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1200', sizes: '(min-width: 1000px) 33vw, 70vw' }}</div>
        {%- endif -%}
        {%- if section.settings.image_secondary != blank -%}
          <div class="media-with-text__image-secondary">{{ section.settings.image_secondary | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300, 500, 800', sizes: '(min-width: 1000px) 20vw, 45vw' }}</div>
        {%- endif -%}
        {%- if section.settings.image_tertiary != blank -%}
          <div class="media-with-text__image-tertiary">{{ section.settings.image_tertiary | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300, 500, 800', sizes: '(min-width: 1000px) 20vw, 45vw' }}</div>
        {%- endif -%}
      </div>
      <div class="media-with-text__content">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="h2 media-with-text__title">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<div class="prose text-subdued">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.settings.button_label != blank -%}
          {%- capture lien_bouton -%}{%- render 'lien', valeur: section.settings.button_link -%}{%- endcapture -%}
          {%- assign destination = lien_bouton | strip | default: routes.all_products_collection_url -%}
          <a href="{{ destination }}" class="button button--navy media-with-text__button">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Médias et texte",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image_main", "label": "Visuel principal" },
    { "type": "image_picker", "id": "image_secondary", "label": "Visuel secondaire (chevauchement)" },
    { "type": "image_picker", "id": "image_tertiary", "label": "Visuel tertiaire (facultatif) — troisième intention" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre" },
    { "type": "text", "id": "heading", "label": "Titre" },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "text", "id": "button_label", "label": "Libellé du bouton" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" }
  ],
  "presets": [ { "name": "Médias et texte" } ]
}
{% endschema %}
