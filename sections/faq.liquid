{%- comment -%}
  Bloc « Besoin d'aide ? / Questions fréquentes » — accordéons, structure
  relevée en bas de la page collection. Les questions restent vides tant que
  LLUFAN ne les a pas fournies (aucune information de livraison ou de retour
  n'est inventée).
{%- endcomment -%}
<div class="section-spacing color-scheme color-scheme--scheme-1 bordered-section">
  <div class="container container--md">
    <div class="v-stack gap-6">
      <div class="v-stack gap-2">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="h3">{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
      <div>
        {%- for block in section.blocks -%}
          {%- if block.settings.question != blank -%}
            <details class="accordion" {{ block.shopify_attributes }}>
              <summary class="accordion__toggle">
                <span>{{ block.settings.question }}</span>
                <span class="animated-plus" aria-hidden="true"></span>
              </summary>
              <div class="accordion__content prose">{{ block.settings.answer }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- comment -%}
        Destination du bouton contact : le lien choisi, sinon la page « contact »
        si la boutique en a une, sinon WhatsApp (le canal de contact de LLUFAN),
        sinon rien — jamais un lien mort.
      {%- endcomment -%}
      {%- capture lien_contact_resolu -%}{%- render 'lien', valeur: section.settings.contact_link -%}{%- endcapture -%}
      {%- assign lien_contact = lien_contact_resolu | strip -%}
      {%- if lien_contact == blank and pages['contact'] != blank -%}{%- assign lien_contact = pages['contact'].url -%}{%- endif -%}
      {%- if lien_contact == blank -%}
        {%- capture lien_whatsapp -%}{%- render 'whatsapp', mode: 'lien' -%}{%- endcapture -%}
        {%- assign lien_contact = lien_whatsapp | strip -%}
      {%- endif -%}
      {%- if section.settings.contact_label != blank and lien_contact != blank -%}
        <div><a class="button button--outline" href="{{ lien_contact }}">{{ section.settings.contact_label }}</a></div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Questions fréquentes",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre" },
    { "type": "text", "id": "heading", "label": "Titre" },
    { "type": "text", "id": "contact_label", "label": "Libellé du lien de contact" },
    { "type": "url", "id": "contact_link", "label": "Lien de contact" }
  ],
  "blocks": [
    { "type": "item", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question" },
      { "type": "richtext", "id": "answer", "label": "Réponse", "info": "Réponse LLUFAN à fournir (livraison, retours, paiement...)." }
    ] }
  ],
  "presets": [ { "name": "Questions fréquentes", "blocks": [ { "type": "item" }, { "type": "item" }, { "type": "item" } ] } ]
}
{% endschema %}
