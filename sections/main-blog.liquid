{%- comment -%}Liste d'articles{%- endcomment -%}
<div class="section-spacing color-scheme color-scheme--scheme-1">
  <div class="container">
    <div class="section-stack">
      <div class="section-header"><h1 class="h2">{{ blog.title }}</h1></div>
      <div class="product-list">
        {%- for article in blog.articles -%}
          <article class="product-card">
            <div class="product-card__figure">
              <a class="product-card__media" href="{{ article.url }}">
                {%- if article.image -%}
                  {{ article.image | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'product-card__image', widths: '300, 500, 800, 1000', sizes: '(min-width: 1000px) 25vw, 50vw', alt: article.title }}
                {%- endif -%}
              </a>
            </div>
            <div class="product-card__info">
              <a class="product-card__title h6" href="{{ article.url }}">{{ article.title }}</a>
              <span class="text-subdued" style="font-size:var(--text-sm)">{{ article.published_at | date: '%d/%m/%Y' }}</span>
            </div>
          </article>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Blog",
  "tag": "section",
  "settings": []
}
{% endschema %}
