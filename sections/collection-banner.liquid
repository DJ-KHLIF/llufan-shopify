{%- comment -%}
  Bandeau de collection — visuel panoramique (proportion 3:1 relevée sur la
  référence), titre serif centré et description.
{%- endcomment -%}
<div class="collection-banner color-scheme color-scheme--scheme-3">
  {%- if section.settings.image != blank -%}
    {{ section.settings.image | image_url: width: 3200 | image_tag: class: 'collection-banner__image', loading: 'eager', widths: '600, 900, 1200, 1600, 2200, 3200', sizes: '100vw', alt: collection.title }}
  {%- elsif collection.image != blank -%}
    {{ collection.image | image_url: width: 3200 | image_tag: class: 'collection-banner__image', loading: 'eager', widths: '600, 900, 1200, 1600, 2200, 3200', sizes: '100vw', alt: collection.title }}
  {%- elsif settings.mode_demo -%}
    <img src="{{ 'demo-collection-banner.jpg' | asset_img_url: '2400x' }}" class="collection-banner__image" alt="{{ collection.title | default: 'Visuel de démonstration' | escape }}" width="2000" height="680" loading="eager">
  {%- else -%}
    <div class="collection-banner__placeholder"><span class="eyebrow">{{ 'sections.collection_banner.image_placeholder' | t }}</span></div>
  {%- endif -%}
  <div class="collection-banner__content">
    <div class="prose text-center">
      <h1 class="h1--serif">{{ collection.title }}</h1>
      {%- if section.settings.show_description and collection.description != blank -%}
        <div class="collection-description">{{ collection.description }}</div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Bandeau de collection",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Visuel (sinon image de la collection)" },
    { "type": "checkbox", "id": "show_description", "label": "Afficher la description", "default": true }
  ]
}
{% endschema %}
