{%- comment -%}Page de protection de la boutique{%- endcomment -%}
<div class="section-spacing color-scheme color-scheme--scheme-1" style="min-height:70vh;display:grid;place-items:center">
  <div class="container container--narrow text-center v-stack gap-6 items-center">
    <h1 class="h1--serif">{{ shop.name }}</h1>
    {%- if shop.password_message != blank -%}<div class="prose">{{ shop.password_message }}</div>{%- endif -%}
    {%- form 'storefront_password', class: 'v-stack gap-3' -%}
      {%- if form.errors -%}<p class="product-form__error">{{ form.errors | default_errors }}</p>{%- endif -%}
      <label class="field"><span class="sr-only">{{ 'customers.password' | t }}</span>
        <input class="input" type="password" name="password" placeholder="{{ 'customers.password' | t }}" required>
      </label>
      <button type="submit" class="button button--navy">{{ 'customers.sign_in' | t }}</button>
    {%- endform -%}
  </div>
</div>
