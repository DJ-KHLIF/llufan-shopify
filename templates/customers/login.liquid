<div class="section-spacing color-scheme color-scheme--scheme-1">
  <div class="container container--narrow">
    <div class="v-stack gap-6">
      <div class="section-header"><h1 class="h2">{{ 'customers.login' | t }}</h1></div>
      {%- form 'customer_login', class: 'v-stack gap-4' -%}
        {%- if form.errors -%}<p class="product-form__error">{{ form.errors | default_errors }}</p>{%- endif -%}
        <label class="field"><span class="field__label">{{ 'customers.email' | t }}</span><input class="input" type="email" name="customer[email]" autocomplete="email" required></label>
        <label class="field"><span class="field__label">{{ 'customers.password' | t }}</span><input class="input" type="password" name="customer[password]" autocomplete="current-password" required></label>
        <button type="submit" class="button button--navy">{{ 'customers.sign_in' | t }}</button>
        <a href="{{ routes.account_register_url }}" class="text-center">{{ 'customers.register' | t }}</a>
        <a href="#recover" class="text-center text-subdued">{{ 'customers.reset_password' | t }}</a>
      {%- endform -%}
      <div id="recover">
        {%- form 'recover_customer_password', class: 'v-stack gap-4' -%}
          {%- if form.posted_successfully? -%}<p class="text-subdued">{{ 'customers.reset_password' | t }} : {{ 'contact.success' | t }}</p>{%- endif -%}
          <label class="field"><span class="field__label">{{ 'customers.email' | t }}</span><input class="input" type="email" name="email" required></label>
          <button type="submit" class="button button--outline">{{ 'customers.reset_password' | t }}</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>
