[
  {
    "name": "theme_info",
    "theme_name": "LLUFAN",
    "theme_version": "1.0.0",
    "theme_author": "LLUFAN",
    "theme_documentation_url": "https://shopify.dev/docs/storefronts/themes",
    "theme_support_url": "https://shopify.dev/docs/storefronts/themes"
  },
  {
    "name": "Identité",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo (utilisé par défaut dans l'en-tête)"
      },
      {
        "type": "color",
        "id": "hero_placeholder_color",
        "label": "Fond des visuels manquants",
        "default": "#E7E2DD"
      },
      {
        "type": "checkbox",
        "id": "mode_demo",
        "label": "Mode démonstration (visuels fictifs)",
        "default": false,
        "info": "Utilise les visuels de démonstration livrés avec le thème partout où aucun visuel n'a encore été choisi (diaporama, cartes d'univers, bandeau de collection, bloc éditorial). À décocher avant la mise en ligne : les visuels LLUFAN choisis dans les sections reprennent alors la main."
      },
      {
        "type": "image_picker",
        "id": "partage_image",
        "label": "Image de partage",
        "info": "L'image qui s'affiche quand on partage un lien LLUFAN (WhatsApp, Facebook, Messenger). Sans elle, on utilise le visuel de la page ouverte, puis le logo. Format conseillé : 1200 × 630 px."
      }
    ]
  },
